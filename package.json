{
  "name": "employee-management-playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:local": "npx playwright test & python ../employee-management-portal/scripts/log_build_metadata.py",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "coverage:per-test": "node scripts/generate-per-test-coverage.js",
    "coverage:report": "cd ../employee-management-portal && ..\\employee-management-playwright\\node_modules\\.bin\\nyc report --temp-dir ..\\employee-management-playwright\\.nyc_output --reporter=html --reporter=text --report-dir ..\\employee-management-playwright\\coverage && cd ..\\employee-management-playwright && npm run coverage:per-test",
    "clean": "rimraf .nyc_output coverage allure-results allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3"
  }
}
